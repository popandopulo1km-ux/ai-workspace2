# /etc/systemd/system/waterman-passport-snapshot.service
[Unit]
Description=Daily read-only passport analytics snapshot
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=vibeapp
WorkingDirectory=/opt/app
ExecStart=/usr/bin/node /opt/app/passport-snapshot.mjs --activate
TimeoutStartSec=1500
Nice=15
CPUQuota=25%
MemoryMax=768M
# Environment values omitted from review export
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/app/data/report-snapshot

